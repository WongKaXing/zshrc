# ------------------------------
# 敏感信息：绝不入库
# ------------------------------
secrets.zsh
secrets
*.secret
*.key
.env
.env.*

# ------------------------------
# zsh 运行时产物：每台机器不同，可自动重建
# （.zcompdump-* 同时覆盖 .zwc 编译缓存）
# ------------------------------
.zcompdump-*
.zsh_history
.zsh_sessions/

# ------------------------------
# 配置文件备份：历史快照，不入库
# ------------------------------
*.bak
*.bak-*
*.orig

# ------------------------------
# 自动生成的补全
# uv 自带的 _uv 已在 Homebrew 的 site-functions 里（fpath 已包含），
# 本地这份是生成产物，需要时重建：
#   uv generate-shell-completion zsh > completions/_uv
# ------------------------------
completions/_uv

# ------------------------------
# 编辑器 / macOS 临时文件
# ------------------------------
.DS_Store
*.swp
*.swo
*~
.#*
